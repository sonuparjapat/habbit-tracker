# ============================== Required ==============================

# Postgres connection string (AWS RDS / Neon / Supabase / local)
DATABASE_URL=postgres://user:password@host:5432/anchor
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=production

# ============================== Server ==============================

# Public URL of this API (no trailing slash), e.g. https://api.yourdomain.com
BACKEND_URL=
PORT=4000
# Websites allowed to call this API from the browser (the admin panel / website).
# Comma-separated, e.g. https://yourdomain.com,http://localhost:3000   (* = any site)
CORS_ORIGIN=*
# SSL for the database: defaults to true when NODE_ENV=production. Set false for a local DB.
# DB_SSL=true
# JWT_EXPIRES_IN=30d
# APP_NAME=Holdfast

# ============================== Email ==============================
# Provider is picked automatically:
#   BREVO_API_KEY set           -> Brevo API (recommended)
#   MAIL_USER + MAIL_PASS set   -> SMTP (Gmail needs an App Password, not your normal password)
#   neither                     -> codes are printed in the server log (development)
# Force one with EMAIL_PROVIDER=brevo|smtp|ses|console

# Sender shown to users. Plain address or "Name <address>".
# With Brevo this address must be a verified sender in your Brevo account.
MAIL_FROM=
BREVO_API_KEY=
MAIL_USER=
MAIL_PASS=
# Only for non-Gmail SMTP (Gmail is detected automatically):
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SECURE=false

# ============================== AWS ==============================
# Reserved for file storage (S3). Not used by any feature yet.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# ============================== Payments ==============================
# Reserved for the Premium plan (Razorpay). Not used by any feature yet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============================== Legal ==============================
# Bump when you change your Terms / Privacy Policy — users re-accept in the app.
TERMS_VERSION=2026-11-18
