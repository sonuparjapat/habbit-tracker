# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser (admin panel). * = any.
CORS_ORIGIN=*
# Public name used in emails
APP_NAME=Anchor

# ---------- Database ----------
# Local Postgres, or hosted (AWS RDS / Neon / Supabase / Railway)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anchor
# true for hosted Postgres that requires SSL
DB_SSL=false
DB_POOL_MAX=10

# ---------- Auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# First admin account. Created (or promoted) automatically on start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Email ----------
# console = print emails to the server log (development)
# ses     = AWS SES (set AWS_* below)
# smtp    = any SMTP provider (SendGrid, Mailgun, Brevo, Zoho, Gmail app password...)
EMAIL_PROVIDER=console
EMAIL_FROM="Anchor <no-reply@yourdomain.com>"

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Legal ----------
# Bump when you change your Terms / Privacy Policy. Users re-accept on next login.
TERMS_VERSION=2026-11-18
