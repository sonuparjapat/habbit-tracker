# Copy to .env (Expo loads it automatically). EXPO_PUBLIC_* values are bundled into the app.

# Backend URL including /api. Leave empty in development: the app then uses the
# IP of the computer running `npx expo start` on port 4000 automatically.
#   production: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=

# Set to true only after AdMob is configured in a development/production build
EXPO_PUBLIC_ADS_ENABLED=false
