{
  "expo": {
    "name": "Anchor",
    "slug": "anchor-discipline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anchor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C11",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.anchor.discipline",
      "infoPlist": {}
    },
    "android": {
      "package": "com.anchor.discipline",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "06138d6e-cd1a-402c-8669-ef945373fa61"
      }
    },
    "owner": "sonu992000parjapat"
  }
}
