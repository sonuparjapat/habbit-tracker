# ---------------- Server-only (never sent to the browser) ----------------

# Base URL of the Anchor backend (no trailing slash, without /api)
#   local:      http://localhost:4000
#   production: https://api.yourdomain.com
API_URL=http://localhost:4000

# Name of the httpOnly cookie that holds the signed-in session
SESSION_COOKIE_NAME=anchor_session

# Session length in days (keep in sync with JWT_EXPIRES_IN on the backend)
SESSION_MAX_AGE_DAYS=30

# ---------------- Public (inlined into the browser bundle at build time) ----------------

NEXT_PUBLIC_APP_NAME=Anchor
# Public URL of this website (used for metadata / links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Play Store link shown on the website (leave empty until published)
NEXT_PUBLIC_PLAY_STORE_URL=
